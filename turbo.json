{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.mjs", ".prettierrc", ".nvmrc"],
  "globalPassThroughEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "FULFILLMENT_DRY_RUN",
    "TON_NETWORK",
    "API_PORT",
    "WEB_URL",
    "ADMIN_URL",
    "LOG_LEVEL",
    "TRUST_PROXY",
    "SWAGGER_ENABLED",
    "BRAND_NAME",
    "TON_MAX_PER_ORDER_NANO",
    "TON_MAX_DAILY_NANO",
    "TON_MIN_BALANCE_ALERT_NANO",
    "SUPPLIER_MAX_PER_ORDER_MICRO_USDT",
    "PRICE_TOLERANCE_BPS",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_BOT_USERNAME",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_API_MOCKS",
    "NEXT_PUBLIC_SUPPORT_URL",
    "NEXT_PUBLIC_TELEGRAM_CHANNEL_URL",
    "NEXT_PUBLIC_ANALYTICS_SITE_ID",
    "API_INTERNAL_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "src/generated/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "db:generate": {
      "outputs": ["src/generated/**"]
    },
    "@repo/db#build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**"]
    },
    "@repo/db#lint": {
      "dependsOn": ["^build", "db:generate"]
    },
    "@repo/db#typecheck": {
      "dependsOn": ["^build", "db:generate"]
    },
    "@repo/db#test": {
      "dependsOn": ["^build", "db:generate"]
    },
    "@repo/db#test:e2e": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false
    }
  }
}
