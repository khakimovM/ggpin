# CLI-only (prisma migrate / studio). Apps read DATABASE_URL from their own validated env.
DATABASE_URL=postgresql://ggpin:ggpin@localhost:5433/ggpin
# `npm run db:seed` publishes the demo products (isActive=true) ONLY when NODE_ENV is exactly
# "development" or "test". With NODE_ENV unset, "production" or anything else they are created
# inactive. For local demo data run: NODE_ENV=development npm run db:seed
