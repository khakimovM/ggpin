// Source of truth for the ggpin database (docs/03-DATA-MODEL.md describes it; D-22, D-23).
//
// Conventions
// - Money is BigInt in minor units, unit in the column name (Tiyin / MicroUsdt / NanoTon / Minor).
// - ids are cuid2. Table names are the model names (PascalCase), so raw SQL uses "Wallet" etc.
// - `updatedAt` exists only on tables whose rows are mutated. Append-only tables never get it:
//   LedgerEntry, CoinEntry, AuditLog, OrderEvent, BankMessage, BankMessageText,
//   BankMessageOutcome (plus the immutable snapshots FxRate, WalletSnapshot, BonusRedemption
//   and the insert-only Wallet lock row).
// - onDelete policy: Restrict on every relation, so money/audit history can never be
//   cascade-deleted. The only exception is Cascade on credential tables (WebSession,
//   AdminSession), which hold no history. SetNull is never used: it would silently rewrite
//   history rows.
// - Beyond what Prisma can express, the migrations add raw SQL that is the real money
//   guardrail and is NOT visible in this file: CHECK constraints (ledger sign per kind,
//   amounts > 0, bps 0..10000, usedCount <= maxUses, no self-referral ...) and BEFORE UPDATE/
//   DELETE triggers that make LedgerEntry, CoinEntry, OrderEvent and AuditLog append-only,
//   and (phase 4) the P2P guards: BankMessage / BankMessageOutcome / BankMessageText
//   append-only, TopupCard identity immutable, PaymentIntent transition guard, the
//   reservation EXCLUDE constraint, Payment <-> bank message / intent consistency.
//   See docs/03-DATA-MODEL.md "Migratsiya 2" and "Migratsiya 9".
// - Polymorphic references have no FK by nature: LedgerEntry/CoinEntry (refType, refId),
//   AuditLog (actorId, targetType, targetId), Setting.updatedBy.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // NodeNext resolution needs explicit extensions; ".js" maps to the .ts sources and survives tsc.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  uz
  ru
}

model User {
  id             String    @id @default(cuid(2))
  telegramId     BigInt    @unique
  username       String?
  firstName      String?
  lastName       String?
  photoUrl       String?
  phone          String? // faqat foydalanuvchi ulashsa
  locale         Locale    @default(uz)
  referralCode   String    @unique
  referredById   String?
  referredBy     User?     @relation("Referrals", fields: [referredById], references: [id], onDelete: Restrict)
  referrals      User[]    @relation("Referrals")
  isBlocked      Boolean   @default(false)
  purchaseFrozen Boolean   @default(false) // to‘lov qaytarilib, balans manfiy bo‘lsa
  // Foydalanuvchi botni bloklagan (my_chat_member / Telegram 403). Admin bloki `isBlocked` EMAS:
  // u USER_BLOCKED beradi, bu esa faqat bildirishnoma yuborishni to‘xtatadi.
  botBlockedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastSeenAt     DateTime?

  wallet           Wallet?
  ledgerEntries    LedgerEntry[]
  coinEntries      CoinEntry[]
  quotes           Quote[]
  orders           Order[]
  paymentIntents   PaymentIntent[]
  bonusRedemptions BonusRedemption[]
  discountCodes    DiscountCode[]
  webSessions      WebSession[]
  payments         Payment[]

  @@index([referredById])
}

// Balans saqlanmaydi; bu jadval faqat FOR UPDATE qulfi uchun. Qator bir marta yaratiladi.
model Wallet {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
}

enum LedgerKind {
  TOPUP
  TOPUP_REVERSAL
  PURCHASE
  REFUND
  REFERRAL_BONUS
  REFERRAL_BONUS_REVERSAL
  ADJUSTMENT
}

// Append-only: no updatedAt, rows are never updated or deleted. Enforced by a DB trigger, and the
// sign of amountTiyin per kind by a CHECK (TOPUP/REFUND/REFERRAL_BONUS > 0; TOPUP_REVERSAL/
// PURCHASE/REFERRAL_BONUS_REVERSAL < 0; ADJUSTMENT <> 0).
model LedgerEntry {
  id          String     @id @default(cuid(2))
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  kind        LedgerKind
  amountTiyin BigInt // ishorali: + kirim, − chiqim
  // PAYMENT | ORDER | REFERRAL | ADMIN_ACTION. The (refType, refId, kind) unique is the
  // idempotency guard, so one order can have one REFUND. Convention: the automatic refund of a
  // failed/cancelled order and a full admin refund use ORDER/<orderId>; every admin PARTIAL
  // refund or adjustment uses ADMIN_ACTION/<AuditLog.id>, so several partial refunds of one
  // order never collide.
  refType     String
  refId       String
  note        String?
  createdAt   DateTime   @default(now())

  @@unique([refType, refId, kind])
  @@index([userId, createdAt])
}

enum CoinKind {
  EARN
  SPEND
  EXPIRE
  ADJUSTMENT
  REVERSAL
}

// Append-only (see LedgerEntry); a CHECK fixes the sign per kind (EARN > 0; SPEND/EXPIRE < 0;
// ADJUSTMENT/REVERSAL <> 0). REVERSAL undoes a cashback EARN when a delivered order is refunded.
model CoinEntry {
  id        String   @id @default(cuid(2))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  kind      CoinKind
  coins     BigInt
  refType   String
  refId     String
  createdAt DateTime @default(now())

  @@unique([refType, refId, kind])
  @@index([userId, createdAt])
}

// ---------- Katalog ----------
enum DeliveryType {
  TG_USERNAME
  GAME_ID
  STEAM_LOGIN
  VOUCHER
  USERNAME
}

model Category {
  id        String    @id @default(cuid(2))
  slug      String    @unique
  nameUz    String
  nameRu    String
  sort      Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id             String         @id @default(cuid(2))
  slug           String         @unique
  categoryId     String
  category       Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  nameUz         String
  nameRu         String
  descriptionUz  String?
  descriptionRu  String?
  helpUz         String? // "ID'ni qayerdan topaman?"
  helpRu         String?
  imageUrl       String
  regionBadge    String? // GLOBAL | SNG | UZ ...
  deliveryType   DeliveryType
  inputSchema    Json // forma maydonlari: [{key:"playerId",type:"digits",min:5,max:12}, ...]
  isAuto         Boolean        @default(true)
  isFeatured     Boolean        @default(false)
  isActive       Boolean        @default(false)
  allowCustomQty Boolean        @default(false) // Stars: erkin miqdor
  minQty         Int?
  maxQty         Int?
  sort           Int            @default(0)
  skus           Sku[]
  routes         ProductRoute[]
  quotes         Quote[]
  costSnapshots  CostSnapshot[]
  orders         Order[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([categoryId])
}

model Sku {
  id             String         @id @default(cuid(2))
  productId      String
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  tab            String? // "UC tezkor" / "To‘plamlar" kabi guruh (i18n kaliti)
  labelUz        String // "60 UC", "3 oylik"
  labelRu        String
  quantity       Int // 60 (UC), 3 (oy), 1 (voucher)
  supplierSku    String? // ta'minotchidagi kod
  markupBps      Int // ustama, bazis punktda (1500 = 15%)
  minMarginTiyin BigInt         @default(0)
  isActive       Boolean        @default(true)
  sort           Int            @default(0)
  vouchers       Voucher[]
  quotes         Quote[]
  costSnapshots  CostSnapshot[]
  orders         Order[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([productId])
}

// Mahsulot → adapter (ustuvorlik tartibida)
model ProductRoute {
  id        String   @id @default(cuid(2))
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  adapter   String // FRAGMENT | RESELLER_STARS | FAZERCARDS | ...
  priority  Int
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, adapter])
}

enum VoucherStatus {
  AVAILABLE
  RESERVED
  SOLD
  INVALID
}

// The Voucher <-> Order link lives ONLY here (orderId). 03 had it on both sides (Voucher.orderId
// and Order.voucherId), which can disagree. The voucher row is the one that is reserved and sold,
// so the inventory side owns the pointer; the order reads it back via `Order.voucher`.
model Voucher {
  id            String        @id @default(cuid(2))
  skuId         String
  sku           Sku           @relation(fields: [skuId], references: [id], onDelete: Restrict)
  codeEnc       String // shifrlangan
  codeHash      String        @unique
  status        VoucherStatus @default(AVAILABLE)
  orderId       String?       @unique
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  costMicroUsdt BigInt
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([skuId, status])
}

// ---------- Narx ----------
// Immutable snapshot: quotes point at the exact rate that priced them.
model FxRate {
  id        String   @id @default(cuid(2))
  pair      String // USDT_UZS, TON_USDT, TON_UZS
  rate      String // o‘nlik qator (decimal string), hisob BigInt'da
  source    String
  createdAt DateTime @default(now())
  quotes    Quote[]
  orders    Order[]

  @@index([pair, createdAt])
}

model Quote {
  id             String          @id @default(cuid(2))
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  skuId          String?
  sku            Sku?            @relation(fields: [skuId], references: [id], onDelete: Restrict)
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity       Int
  recipient      Json // tekshirilgan qabul qiluvchi: {username, displayName, ...}
  costCurrency   String // TON | USDT
  costMinor      BigInt // nanoTON yoki microUSDT
  fxRateId       String
  fxRate         FxRate          @relation(fields: [fxRateId], references: [id], onDelete: Restrict)
  costSnapshotId String // narx hisoblangan tannarx snapshot'i
  costSnapshot   CostSnapshot    @relation(fields: [costSnapshotId], references: [id], onDelete: Restrict)
  priceTiyin     BigInt
  maxCostMinor   BigInt // shu chegaradan oshsa — HELD
  discountCodeId String?
  discountCode   DiscountCode?   @relation(fields: [discountCodeId], references: [id], onDelete: Restrict)
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  order          Order?
  paymentIntents PaymentIntent[]

  @@index([userId, createdAt])
  @@index([skuId])
  @@index([productId])
  @@index([fxRateId])
  @@index([costSnapshotId])
  @@index([discountCodeId])
  @@index([expiresAt])
}

// Narx sinxronlash worker'i yozadigan tannarx snapshot'i. O‘zgarmas (updatedAt yo‘q, UPDATE trigger bilan
// taqiqlangan): Quote shu qatorga havola qiladi, shuning uchun "narx qaysi tannarxdan chiqqan" keyinroq ham
// isbotlanadi. skuId null — mahsulot darajasidagi qator (Stars: basisQuantity 1 uchun narx).
model CostSnapshot {
  id            String   @id @default(cuid(2))
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  skuId         String?
  sku           Sku?     @relation(fields: [skuId], references: [id], onDelete: Restrict)
  adapter       String // FRAGMENT | RESELLER_STARS | ...
  currency      String // TON | USDT
  basisQuantity Int // costMinor shu miqdor uchun (Stars: 1, Premium: SKU miqdori)
  costMinor     BigInt // nanoTON yoki microUSDT
  source        String // 'simulator' | 'fragment' | ...
  createdAt     DateTime @default(now())
  quotes        Quote[]

  @@index([productId, skuId, createdAt])
  // Catalog read: productId IN (...) AND createdAt BETWEEN ..., and the product-level "latest"
  // lookup (skuId IS NULL). The three-column index above cannot bound a createdAt range while
  // skuId is unconstrained, so those reads scanned a product's whole history.
  @@index([productId, createdAt])
  @@index([skuId])
}

// ---------- Buyurtma ----------
// Must equal ORDER_STATUSES in packages/shared/src/order-state.ts (asserted by a DB test).
enum OrderStatus {
  PAID
  QUEUED
  PROCESSING
  HELD
  NEEDS_REVIEW
  DELIVERED
  FAILED
  CANCELLED
  REFUNDED
}

model Order {
  id             String               @id @default(cuid(2))
  number         Int                  @unique @default(autoincrement()) // foydalanuvchiga ko‘rinadigan #
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  quoteId        String               @unique
  quote          Quote                @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  productId      String
  product        Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  skuId          String?
  sku            Sku?                 @relation(fields: [skuId], references: [id], onDelete: Restrict)
  quantity       Int
  recipient      Json
  priceTiyin     BigInt // chegirmadan oldingi narx; to‘langan summa = priceTiyin − discountTiyin
  discountTiyin  BigInt               @default(0)
  costCurrency   String
  costMinor      BigInt
  maxCostMinor   BigInt
  // FX snapshot that priced the order (rule 40); equals Quote.fxRateId at creation time.
  fxRateId       String
  fxRate         FxRate               @relation(fields: [fxRateId], references: [id], onDelete: Restrict)
  status         OrderStatus
  statusReason   String?
  idempotencyKey String
  requestHash    String // same key + different body → 409 IDEMPOTENCY_CONFLICT
  deliveredAt    DateTime?
  voucher        Voucher? // reverse side of Voucher.orderId
  discountCode   DiscountCode? // reverse side of DiscountCode.usedOrderId
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  attempts       FulfillmentAttempt[]
  events         OrderEvent[]

  @@unique([userId, idempotencyKey])
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([productId])
  @@index([skuId])
  @@index([fxRateId])
}

// Holat tarixi (audit). Append-only.
model OrderEvent {
  id        String       @id @default(cuid(2))
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  from      OrderStatus?
  to        OrderStatus
  actor     String // SYSTEM | WORKER | ADMIN:<id>
  note      String?
  createdAt DateTime     @default(now())

  @@index([orderId, createdAt])
}

enum AttemptStatus {
  SENDING
  SENT
  CONFIRMED
  FAILED
  UNKNOWN
}

model FulfillmentAttempt {
  id          String        @id @default(cuid(2))
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  attemptNo   Int
  adapter     String
  status      AttemptStatus
  externalRef String? // TON message hash / supplier order id / Fragment req_id
  request     Json // sirlarsiz
  response    Json?
  costMinor   BigInt?
  error       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([orderId, attemptNo])
  // One external payout (TON message hash / supplier order id) belongs to exactly one attempt;
  // NULLs stay allowed. Kept separate from the plain index below because that one serves
  // lookups by externalRef ALONE (reconciler: tx hash from the chain), which this unique
  // cannot (it leads with adapter).
  @@unique([adapter, externalRef])
  @@index([externalRef])
}

// ---------- To‘lovlar ----------
enum PaymentProviderCode {
  CLICK
  PAYME
  UZUM
  RAHMAT
  TG_STARS
  P2P_CARD
}

enum IntentStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

model PaymentIntent {
  id              String              @id @default(cuid(2))
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  provider        PaymentProviderCode
  amountTiyin     BigInt
  status          IntentStatus        @default(PENDING)
  purpose         String // TOPUP | TOPUP_AND_BUY
  quoteId         String? // TOPUP_AND_BUY bo‘lsa
  quote           Quote?              @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  idempotencyKey  String
  requestHash     String // same key + different body → 409 IDEMPOTENCY_CONFLICT
  expiresAt       DateTime
  // P2P_CARD only (a CHECK requires cardId + baseAmountTiyin for that provider). amountTiyin is
  // then base + unique suffix: the exact amount the user must transfer.
  cardId          String?
  card            TopupCard?          @relation(fields: [cardId], references: [id], onDelete: Restrict)
  baseAmountTiyin BigInt? // the amount the user asked for, without the suffix
  paidAt          DateTime? // set exactly when status = PAID (CHECK)
  // The unique amount stays taken on the card until here. Set at creation to expiresAt + grace,
  // set to exactly GREATEST(old, paidAt + (old - expiresAt)) when the intent becomes PAID (the
  // grace is the gap fixed at creation; the writer computes it, the BEFORE UPDATE trigger only
  // refuses any other value), left unchanged on CANCELLED / EXPIRED. The same trigger enforces
  // the status graph and bounds paidAt to createdAt - 5 min .. now + 5 min.
  // Required for P2P_CARD (CHECK). The one place the grace window is stored: allocator and
  // matcher read it instead of recomputing. A GiST EXCLUDE (raw SQL, migration 9) makes two
  // overlapping reservations of one amount on one card impossible.
  reservedUntil   DateTime?
  payTokenHash    String?             @unique // HMAC-SHA256 of the pay-link capability token (D-39)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  payments        Payment[]
  reviews         PaymentReview[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([quoteId])
  @@index([status, createdAt])
  // Allocator: taken amounts of a card = cardId = ? AND reservedUntil > now(), read from this
  // index alone (amountTiyin is the last column). Matcher: same prefix, reservedUntil >= tgDate.
  @@index([cardId, reservedUntil, amountTiyin])
  // Per-user count of reservations still held (S4 anti-abuse limits).
  @@index([userId, reservedUntil])
}

enum PaymentStatus {
  CREATED
  CONFIRMED
  CANCELLED
}

model Payment {
  id            String              @id @default(cuid(2))
  // NULL for a payment credited from a review (no intent matched); a CHECK requires an intent
  // or a review.
  intentId      String?
  intent        PaymentIntent?      @relation(fields: [intentId], references: [id], onDelete: Restrict)
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  provider      PaymentProviderCode
  providerTxnId String // P2P_CARD: "<senderId>:<tgMessageId>"
  amountTiyin   BigInt
  status        PaymentStatus
  raw           Json // redakt qilingan
  bankMessageId String?             @unique // P2P_CARD: the bank message this payment came from
  bankMessage   BankMessage?        @relation(fields: [bankMessageId], references: [id], onDelete: Restrict)
  reviewId      String?             @unique // set when the owner credited it from a review
  review        PaymentReview?      @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  outcome       BankMessageOutcome?
  confirmedAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([provider, providerTxnId])
  @@index([intentId])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// ---------- P2P karta orqali to‘ldirish (D-31/D-32) ----------
enum CardBank {
  HUMO
  UZCARD
}

enum TopupCardStatus {
  VERIFYING
  ACTIVE
  DRAINING
  FULL
  RETIRED
}

enum BankFeedSource {
  HUMO_BOT
  UZCARD_BOT
}

enum BankParseStatus {
  PARSED
  UNRECOGNIZED
  REJECTED
}

enum BankDirection {
  CREDIT
  DEBIT
}

enum ChainStatus {
  FIRST
  OK
  BREAK
  NOT_APPLICABLE
}

enum BankOutcome {
  CREDITED
  CARD_VERIFIED
  DEBIT_RECORDED
  REVIEW
}

enum PaymentReviewKind {
  UNRECOGNIZED
  REJECTED
  CARD_UNKNOWN
  CARD_RETIRED
  CHAIN_BREAK
  AUTO_CREDIT_PAUSED
  NO_MATCH
  AMBIGUOUS
  DUPLICATE
  TIME_SKEW
  CANCELLED_LATE
  DAILY_LIMIT
  POSSIBLE_REVERSAL
  USER_BLOCKED
}

enum PaymentReviewStatus {
  OPEN
  RESOLVED
}

enum PaymentReviewResolution {
  CREDITED_USER
  IGNORED
  RETURNED_OFFLINE
  CHAIN_ACCEPTED
}

// bank, pan, last4 and holderName never change after INSERT (trigger, GG001); status, limits and
// the pause flag do. pan is our own receiving card (E-13), shown only to the owner of a pending
// intent. DRAINING: no new requests, existing ones are still credited until their reservedUntil.
// CHECKs fix the pan/last4/limits shape and RETIRED <=> retiredAt; a partial unique keeps
// (bank, last4) unique among non-retired cards.
model TopupCard {
  id                String          @id @default(cuid(2))
  bank              CardBank
  pan               String
  last4             String
  holderName        String
  status            TopupCardStatus @default(VERIFYING)
  receiveLimitTiyin BigInt // required at card:add (E-9), no global default
  monthlyLimitTiyin BigInt? // optional monthly cap
  verifyAmountTiyin BigInt // test transfer that moves VERIFYING -> ACTIVE
  verifiedAt        DateTime?
  retiredAt         DateTime?
  autoCreditPaused  Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  intents           PaymentIntent[]
  bankMessages      BankMessage[]
  reviews           PaymentReview[]

  @@index([status, bank])
}

// Append-only (trigger). The raw text is in BankMessageText (kept 1 year, E-25; never logged).
model BankMessage {
  id                String              @id @default(cuid(2))
  source            BankFeedSource
  senderId          BigInt
  tgMessageId       BigInt
  tgDate            DateTime
  textSha256        String // sha256 of the raw text; the text itself lives in BankMessageText
  parseStatus       BankParseStatus
  rejectReason      String?
  parserVersion     Int
  direction         BankDirection?
  amountTiyin       BigInt?
  balanceAfterTiyin BigInt?
  last4             String?
  cardId            String?
  card              TopupCard?          @relation(fields: [cardId], references: [id], onDelete: Restrict)
  bankTxnAt         DateTime?
  channel           String?
  createdAt         DateTime            @default(now())
  outcome           BankMessageOutcome?
  rawText           BankMessageText?
  payment           Payment?
  reviews           PaymentReview[]

  @@unique([senderId, tgMessageId])
  @@index([cardId, tgMessageId])
  @@index([createdAt])
}

// The raw bank text, kept apart from the append-only BankMessage so it can be erased after the
// retention period (E-25: 1 year). A trigger allows exactly one change: text -> NULL once
// purgeAfter has passed; any other UPDATE and every DELETE is rejected (GG001). No updatedAt.
model BankMessageText {
  bankMessageId String      @id
  bankMessage   BankMessage @relation(fields: [bankMessageId], references: [id], onDelete: Restrict)
  text          String? // NULL after the purge
  purgeAfter    DateTime
  createdAt     DateTime    @default(now())

  @@index([purgeAfter])
}

// Insert-once (trigger forbids UPDATE/DELETE): the processing result of one bank message.
// CHECKs: CREDITED <=> paymentId, REVIEW => reviewId.
model BankMessageOutcome {
  id            String         @id @default(cuid(2))
  bankMessageId String         @unique
  bankMessage   BankMessage    @relation(fields: [bankMessageId], references: [id], onDelete: Restrict)
  chainStatus   ChainStatus
  outcome       BankOutcome
  paymentId     String?        @unique
  payment       Payment?       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  reviewId      String?
  review        PaymentReview? @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  createdAt     DateTime       @default(now())

  @@index([reviewId])
}

model PaymentReview {
  id                 String                   @id @default(cuid(2))
  kind               PaymentReviewKind
  status             PaymentReviewStatus      @default(OPEN)
  // Every review kind comes out of processing one bank message (docs/05 section 6), so the
  // message is required and (bankMessageId, kind) is the idempotency key of the review.
  bankMessageId      String
  bankMessage        BankMessage              @relation(fields: [bankMessageId], references: [id], onDelete: Restrict)
  cardId             String?
  card               TopupCard?               @relation(fields: [cardId], references: [id], onDelete: Restrict)
  intentId           String?
  intent             PaymentIntent?           @relation(fields: [intentId], references: [id], onDelete: Restrict)
  resolution         PaymentReviewResolution?
  // RESOLVED <=> resolution, resolvedAt and the audit row of the owner's decision (CHECKs).
  resolvedAuditLogId String?
  resolvedAuditLog   AuditLog?                @relation(fields: [resolvedAuditLogId], references: [id], onDelete: Restrict)
  resolvedAt         DateTime?
  note               String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  payment            Payment?
  outcomes           BankMessageOutcome[]

  @@unique([bankMessageId, kind])
  @@index([resolvedAuditLogId])
  @@index([status, createdAt])
  @@index([cardId])
  @@index([intentId])
}

// The last bank-bot message id stored per source; the listener's poll resumes from here.
model BankFeedCursor {
  source        BankFeedSource @id
  lastMessageId BigInt
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// ---------- Promo ----------
model BonusCode {
  id          String            @id @default(cuid(2))
  codeHash    String            @unique
  rewardType  String // WALLET_TIYIN | COINS
  rewardTiyin BigInt? // set only when rewardType = WALLET_TIYIN
  rewardCoins BigInt? // set only when rewardType = COINS
  maxUses     Int
  usedCount   Int               @default(0)
  expiresAt   DateTime?
  createdById String
  createdBy   AdminUser         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  redemptions BonusRedemption[]

  @@index([createdById])
}

// Immutable: a redemption is never edited.
model BonusRedemption {
  id        String    @id @default(cuid(2))
  codeId    String
  code      BonusCode @relation(fields: [codeId], references: [id], onDelete: Restrict)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime  @default(now())

  @@unique([codeId, userId])
  @@index([userId])
}

model DiscountTier {
  id         String         @id @default(cuid(2))
  bps        Int
  priceCoins BigInt
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  codes      DiscountCode[]
}

model DiscountCode {
  id          String       @id @default(cuid(2))
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  tierId      String
  tier        DiscountTier @relation(fields: [tierId], references: [id], onDelete: Restrict)
  bps         Int
  code        String       @unique
  usedOrderId String?      @unique
  usedOrder   Order?       @relation(fields: [usedOrderId], references: [id], onDelete: Restrict)
  expiresAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  quotes      Quote[]

  @@index([userId])
  @@index([tierId])
}

// ---------- Fragment / hamyon ----------
model FragmentSession {
  id         String    @id @default(cuid(2))
  cookiesEnc String // shifrlangan cookie jar
  pageHash   String?
  status     String // ACTIVE | DEAD
  lastOkAt   DateTime?
  lastError  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// Hot wallet balansi tarixi (admin grafik uchun). Append-only.
model WalletSnapshot {
  id        String   @id @default(cuid(2))
  network   String
  address   String
  nanoTon   BigInt
  microUsdt BigInt
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------- Auth / admin ----------
model WebSession {
  id          String    @id @default(cuid(2))
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String    @unique
  familyId    String
  userAgent   String?
  ip          String?
  revokedAt   DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([familyId])
}

// web va admin OTP
model LoginRequest {
  id              String   @id @default(cuid(2))
  nonce           String   @unique
  kind            String // USER | ADMIN
  telegramId      BigInt?
  codeHash        String?
  attempts        Int      @default(0)
  status          String // PENDING | CODE_SENT | USED | EXPIRED | DENIED
  expiresAt       DateTime
  // verify bilan ochilgan sessiya oilasi (WebSession.familyId); "Bu men emas" shu oilani tugatadi
  sessionFamilyId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, expiresAt]) // muddati o‘tganlarni tozalash sweep'i uchun
  @@index([telegramId, expiresAt]) // akkaunt bo‘yicha berilgan kodlarni sanash (limit)
}

enum AdminRole {
  OWNER
  OPERATOR
  SUPPORT
}

model AdminUser {
  id         String         @id @default(cuid(2))
  telegramId BigInt         @unique
  name       String
  role       AdminRole
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  sessions   AdminSession[]
  bonusCodes BonusCode[]
  broadcasts Broadcast[]
}

model AdminSession {
  id         String    @id @default(cuid(2))
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  lastUsedAt DateTime
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([adminId])
}

// Append-only. actorId/targetId are polymorphic, hence no FK.
model AuditLog {
  id         String   @id @default(cuid(2))
  actorType  String // ADMIN | SYSTEM
  actorId    String?
  action     String // ORDER_REFUND, WALLET_ADJUST, PRODUCT_UPDATE ...
  targetType String
  targetId   String
  before     Json?
  after      Json?
  reason     String?
  ip         String?
  createdAt  DateTime @default(now())

  paymentReviews PaymentReview[]

  @@index([targetType, targetId])
  @@index([createdAt])
  @@index([actorId, createdAt])
}

model Broadcast {
  id          String    @id @default(cuid(2))
  textUz      String
  textRu      String
  audience    Json
  status      String // DRAFT | SENDING | DONE | CANCELLED
  sentCount   Int       @default(0)
  failCount   Int       @default(0)
  createdById String
  createdBy   AdminUser @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([createdById])
}

// Admin'dan o‘zgaradigan sozlamalar. updatedBy = admin id (no FK: may also be a system actor).
model Setting {
  key       String   @id // REFERRAL_BPS, CASHBACK_BPS, TOPUP_MIN_TIYIN ...
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?
}
