# apps/api — copy to apps/api/.env. Placeholders only; NEVER commit real values.
# Boot validation: apps/api/src/config/env.ts. A missing/invalid variable stops the API and the
# message names it (never its value). The signing/pepper secrets and TELEGRAM_WEBHOOK_SECRET
# may not keep a change-me / <...> placeholder in ANY environment, and a process started with
# NODE_ENV=test refuses to boot outside Jest. With NODE_ENV=production http:// origins and
# generated secrets shorter than 32 chars are rejected too.
# Worker-only secrets (TON_*, WALLET_ENC_KEY, FRAGMENT_*, RESELLER_*, SUPPLIER_*) must NOT
# appear here: from phase 1 the API refuses to boot if they are set.

# Required, no default (development | production; test is for Jest only). Placeholders below are
# rejected at boot in every environment: replace each change-me value before the first run.
NODE_ENV=development
BRAND_NAME=ggpin
DATABASE_URL=postgresql://ggpin:ggpin@localhost:5433/ggpin
REDIS_URL=redis://localhost:6379

API_PORT=5000
LOG_LEVEL=info
# Comma-separated IPs and/or CIDRs (IPv4 or IPv6) of the reverse proxies allowed to set
# X-Forwarded-For. Empty = trust no proxy: X-Forwarded-For is ignored and request.ip is the TCP
# peer. Behind Caddy/Nginx on the same host use 127.0.0.1,::1. In docker compose give the proxy
# container a FIXED address (networks.<net>.ipv4_address) and list exactly that IP, e.g.
# 172.18.0.10. Do NOT list the compose network CIDR: every other container on it would then be
# allowed to forge X-Forwarded-For, and the bridge gateway (.1) is the source of traffic that
# arrives through a published host port. For the same reason the API port must not be
# published: only the proxy may reach it.
# Rejected: true, *, bare numbers (hop counts), IPv4 prefixes shorter than /8, IPv6 prefixes
# shorter than /32. IPv4-mapped IPv6 entries (::ffff:a.b.c.d) are read as plain IPv4.
# Required (non-empty) when NODE_ENV=production.
TRUST_PROXY=
# Swagger is off unless true; NODE_ENV=production refuses to boot with it enabled
SWAGGER_ENABLED=false
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173
# prod: https://ggpin.uz/tg (required in production) — dev: an HTTPS tunnel to the local web app
MINI_APP_URL=
# Auth secrets (required). The four values below MUST differ from each other; in production each
# needs 32+ random characters (e.g. openssl rand -base64 48). OTP_PEPPER keys the hash of
# one-time login codes.
JWT_ACCESS_SECRET=change-me-access-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars
TG_SESSION_SECRET=change-me-tg-session-min-32-chars
OTP_PEPPER=change-me-otp-pepper-min-32-chars
# Telegram bot (required; the token is also used to verify Mini App initData even when
# TELEGRAM_BOT_MODE=off). Token format: <digits>:<secret> from @BotFather. The username must end
# in "bot" and is written without @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=ggpin_bot
# off = bot does not process updates; polling = long polling (dev); webhook = production only
# (then TELEGRAM_WEBHOOK_URL (https) and TELEGRAM_WEBHOOK_SECRET (32-256 chars of A-Z a-z 0-9 _ -)
# are required).
# DEV MUST USE A SEPARATE BOT TOKEN: polling deletes the webhook of the token it runs with, and
# the API refuses to start polling when the token still has a webhook set.
TELEGRAM_BOT_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Optional https://t.me/<channel> link for the bot's News button; the button is hidden when empty.
TELEGRAM_NEWS_CHANNEL_URL=
TG_INITDATA_MAX_AGE_SEC=86400
ADMIN_TELEGRAM_IDS=
ADMIN_CONFIRM_THRESHOLD_TIYIN=100000000
ADMIN_OPERATOR_REFUND_MAX_TIYIN=50000000
OWNER_ALERT_CHAT_ID=
TOPUP_MIN_TIYIN=500000
TOPUP_MAX_TIYIN=1000000000
# Phase 3: how far (basis points, 0-10000; 300 = 3%) the real supplier cost may rise above the
# quoted cost before fulfillment holds the order instead of paying.
PRICE_TOLERANCE_BPS=300

# payments (sandbox in dev)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_MODE=true
UZUM_MERCHANT_ID=
UZUM_SECRET=
RAHMAT_MERCHANT_ID=
RAHMAT_SECRET=
