# apps/api — copy to apps/api/.env. Placeholders only; NEVER commit real values.
# Boot validation: apps/api/src/config/env.ts. A missing/invalid variable stops the API and the
# message names it (never its value). With NODE_ENV=production, change-me*/<...> placeholders,
# http:// origins and generated secrets shorter than 32 chars are rejected.
# Worker-only secrets (TON_*, WALLET_ENC_KEY, FRAGMENT_*, RESELLER_*, SUPPLIER_*) must NOT
# appear here: from phase 1 the API refuses to boot if they are set.

NODE_ENV=development
BRAND_NAME=ggpin
DATABASE_URL=postgresql://ggpin:ggpin@localhost:5433/ggpin
REDIS_URL=redis://localhost:6379

API_PORT=5000
LOG_LEVEL=info
# Comma-separated IPs and/or CIDRs (IPv4 or IPv6) of the reverse proxies allowed to set
# X-Forwarded-For. Empty = trust no proxy: X-Forwarded-For is ignored and request.ip is the TCP
# peer. Behind Caddy/Nginx on the same host use 127.0.0.1,::1; in docker compose use the proxy
# container's network (e.g. the compose network CIDR 172.18.0.0/16, or the proxy's fixed IP).
# Only a peer on this list may speak for a client, so the API must NOT be reachable except via
# the proxy. Rejected: true, *, bare numbers (hop counts), /0 prefixes.
TRUST_PROXY=
# Swagger is off unless true; NODE_ENV=production refuses to boot with it enabled
SWAGGER_ENABLED=false
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173
# prod: https://ggpin.uz/tg — dev: an HTTPS tunnel to the local web app (leave empty until phase 3)
MINI_APP_URL=
JWT_ACCESS_SECRET=change-me-min-32-chars
JWT_REFRESH_SECRET=change-me-min-32-chars
TG_SESSION_SECRET=change-me-min-32-chars
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=ggpin_bot
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TG_INITDATA_MAX_AGE_SEC=86400
ADMIN_TELEGRAM_IDS=
ADMIN_CONFIRM_THRESHOLD_TIYIN=100000000
ADMIN_OPERATOR_REFUND_MAX_TIYIN=50000000
OWNER_ALERT_CHAT_ID=
TOPUP_MIN_TIYIN=500000
TOPUP_MAX_TIYIN=1000000000

# payments (sandbox in dev)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_MODE=true
UZUM_MERCHANT_ID=
UZUM_SECRET=
RAHMAT_MERCHANT_ID=
RAHMAT_SECRET=
