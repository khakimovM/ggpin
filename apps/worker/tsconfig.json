{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    // ts-jest requires it with NodeNext; type safety comes from `tsc --noEmit` (typecheck).
    "isolatedModules": true,
    "types": ["node", "jest"]
  },
  "include": ["src"]
}
