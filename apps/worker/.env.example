# apps/worker — copy to apps/worker/.env. Placeholders only; NEVER commit real values.
# Boot validation: apps/worker/src/config/env.ts (names the bad variable, never its value).
# With NODE_ENV=production, change-me*/<...> placeholders and generated secrets shorter than
# 32 chars are rejected. Limits are integers in minor units (digits only).
# The worker is the ONLY process allowed to hold these secrets (CLAUDE.md §5.7).

# Required, no default.
NODE_ENV=development
BRAND_NAME=ggpin
DATABASE_URL=postgresql://ggpin:ggpin@localhost:5433/ggpin
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
TELEGRAM_BOT_USERNAME=ggpin_bot

# Real money moves only when this is set to false — owner's explicit approval required.
# Defaults to true outside production; in production it must be set explicitly.
FULFILLMENT_DRY_RUN=true
TON_NETWORK=testnet
TON_API_ENDPOINT=
TON_API_KEY=
TON_MNEMONIC_ENC=
WALLET_ENC_KEY=
TON_MAX_PER_ORDER_NANO=50000000000
TON_MAX_DAILY_NANO=500000000000
TON_MIN_BALANCE_ALERT_NANO=100000000000
FRAGMENT_SESSION_ENC_KEY=
PRICE_TOLERANCE_BPS=300
RESELLER_STARS_API_URL=
RESELLER_STARS_API_KEY=
SUPPLIER_MAX_PER_ORDER_MICRO_USDT=200000000

# Phase 4 (P2P top-ups, docs/05 §6). MUST equal the API values (apps/api/.env.example): the
# API allocates and caps with them, the worker matches, turns cards FULL and re-checks caps.
TOPUP_INTENT_TTL_SEC=1800
TOPUP_LATE_GRACE_SEC=86400
TOPUP_CAPACITY_HOLD_SEC=3600
TOPUP_NEW_ACCOUNT_AGE_SEC=604800
TOPUP_DAILY_MAX_TIYIN=500000000
TOPUP_NEW_ACCOUNT_DAILY_MAX_TIYIN=50000000
BANK_TIME_SKEW_SEC=600
# Pinned numeric ids of the bank bots (docs/05 §4); required in production. A stored message
# from any other sender is never credited.
BANK_FEED_HUMO_BOT_ID=
BANK_FEED_UZCARD_BOT_ID=
# lock_timeout of the matcher transactions (ms); a busy card fails the job and it retries.
BANK_FEED_LOCK_TIMEOUT_MS=3000
