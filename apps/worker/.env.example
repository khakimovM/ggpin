# apps/worker — copy to apps/worker/.env. Placeholders only; NEVER commit real values.
# The worker is the ONLY process allowed to hold these secrets (CLAUDE.md §5.7).

NODE_ENV=development
BRAND_NAME=ggpin
DATABASE_URL=postgresql://ggpin:ggpin@localhost:5432/ggpin
REDIS_URL=redis://localhost:6379
TELEGRAM_BOT_USERNAME=ggpin_bot
OWNER_ALERT_CHAT_ID=

# Real money moves only with FULFILLMENT_DRY_RUN=false — owner's explicit approval required.
FULFILLMENT_DRY_RUN=true
TON_NETWORK=testnet
TON_API_ENDPOINT=
TON_API_KEY=
TON_MNEMONIC_ENC=
WALLET_ENC_KEY=
TON_MAX_PER_ORDER_NANO=50000000000
TON_MAX_DAILY_NANO=500000000000
TON_MIN_BALANCE_ALERT_NANO=100000000000
FRAGMENT_SESSION_ENC_KEY=
PRICE_TOLERANCE_BPS=300
RESELLER_STARS_API_URL=
RESELLER_STARS_API_KEY=
SUPPLIER_MAX_PER_ORDER_MICRO_USDT=200000000
