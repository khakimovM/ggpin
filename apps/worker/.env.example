# apps/worker — copy to apps/worker/.env. Placeholders only; NEVER commit real values.
# Boot validation: apps/worker/src/config/env.ts (names the bad variable, never its value).
# With NODE_ENV=production, change-me*/<...> placeholders and generated secrets shorter than
# 32 chars are rejected. Limits are integers in minor units (digits only).
# The worker is the ONLY process allowed to hold these secrets (CLAUDE.md §5.7).

# Required, no default.
NODE_ENV=development
BRAND_NAME=ggpin
DATABASE_URL=postgresql://ggpin:ggpin@localhost:5433/ggpin
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
TELEGRAM_BOT_USERNAME=ggpin_bot

# Real money moves only when this is set to false — owner's explicit approval required.
# Defaults to true outside production; in production it must be set explicitly.
FULFILLMENT_DRY_RUN=true
TON_NETWORK=testnet
# With FULFILLMENT_DRY_RUN=false (docs/06, "5-faza S5"): https always, and the host must serve
# TON_NETWORK (toncenter.com = mainnet, testnet.toncenter.com = testnet). TON_API_KEY is then
# required (worker-only secret, dropped from the environment after boot). A live mainnet worker
# is refused until a second, independent chain source for the EXPIRED proof exists (D-60 (2)).
TON_API_ENDPOINT=
TON_API_KEY=
# Comma-separated Fragment payee addresses (raw 0:<hex> or user-friendly, workchain 0). An ORDER
# payout to any other address is HELD before signing; required on a live mainnet worker. Checked
# in every mode, so a typo shows up before going live. Not a secret.
# Dry run too: left empty, every ORDER payout is HELD (nothing is ever allowed implicitly). To run
# one through the in-memory chain in dev, list the payee address the simulator uses here.
FRAGMENT_PAY_ADDRESSES=
# Phase 5 TON hot wallet (W5R1). With FULFILLMENT_DRY_RUN=true none of these is read: the worker
# signs with a throw-away key on an in-memory chain. With DRY_RUN=false all four are required.
# TON_MNEMONIC_ENC and TON_WALLET_ADDRESS come from `npm run ton:encrypt-mnemonic -w worker`
# (the mnemonic is typed on the terminal, never put in a file); the boot refuses a mnemonic
# whose wallet is not TON_WALLET_ADDRESS on TON_NETWORK.
TON_MNEMONIC_ENC=
TON_WALLET_ADDRESS=
# WALLET_ENC_KEY: 32 random bytes, base64. Production: ONLY as a file (Docker secret), mode 0400
# or 0600; read once, then dropped from the environment.
# WALLET_ENC_KEY_FILE=/run/secrets/wallet_enc_key
# Dev/test only (refused in production; never both at once):
WALLET_ENC_KEY=
# validUntil of a signed message (30..300 s after the chain time it is signed at).
TON_SEND_VALID_SEC=60
# Watch a payout this long before the order goes to NEEDS_REVIEW; must exceed
# TON_SEND_VALID_SEC + 60 s + 30 s + 90 s + 6 s (the EXPIRED proof needs two observations 30 s
# apart, the chain time at signing may be up to 90 s ahead of the database clock, and each
# observation may come one 3 s poll late).
TON_CONFIRM_TIMEOUT_MS=300000
# Kept on top of the amount when the balance is checked (network fees), nanotons.
TON_FEE_RESERVE_NANO=50000000
# Hot-wallet limits, nanotons. The defaults serve dry runs only: with FULFILLMENT_DRY_RUN=false
# both maxima must be set explicitly. The 24 h sum counts every transfer that may have left
# (EXPIRED included). Exactly at a limit is allowed; one nanoton above holds the order.
TON_MAX_PER_ORDER_NANO=50000000000
TON_MAX_DAILY_NANO=500000000000
TON_MIN_BALANCE_ALERT_NANO=100000000000
FRAGMENT_SESSION_ENC_KEY=
PRICE_TOLERANCE_BPS=300
RESELLER_STARS_API_URL=
RESELLER_STARS_API_KEY=
SUPPLIER_MAX_PER_ORDER_MICRO_USDT=200000000

# Phase 4 (P2P top-ups, docs/05 §6). MUST equal the API values (apps/api/.env.example): the
# API allocates and caps with them, the worker matches, turns cards FULL and re-checks caps.
TOPUP_INTENT_TTL_SEC=1800
TOPUP_LATE_GRACE_SEC=86400
TOPUP_CAPACITY_HOLD_SEC=3600
TOPUP_NEW_ACCOUNT_AGE_SEC=604800
TOPUP_DAILY_MAX_TIYIN=500000000
TOPUP_NEW_ACCOUNT_DAILY_MAX_TIYIN=50000000
BANK_TIME_SKEW_SEC=600
# Pinned numeric ids of the bank bots (docs/05 §4); required in production. A stored message
# from any other sender is never credited.
BANK_FEED_HUMO_BOT_ID=
BANK_FEED_UZCARD_BOT_ID=
# lock_timeout of the matcher transactions (ms); a busy card fails the job and it retries.
BANK_FEED_LOCK_TIMEOUT_MS=3000

# Bank-feed Telegram client (phase 4 S7, docs/05 §4): the MTProto listener (live) or the in-memory
# client (fake). live needs API_ID, API_HASH, SESSION_ENC, the key and both bot ids; the two bot
# ids must differ (each at most 2^53 - 1). Login: npm run -s bank-feed:login -w worker, or
# node dist/cli/bank-feed-login.js (TTY on the VPS; -s keeps npm from echoing the command).
# Worker-only secrets: the API refuses to boot when any BANK_FEED_* secret is in its environment
# (packages/shared/src/env-secrets.ts). The session is AES-256-GCM encrypted at rest
# (BANK_FEED_SESSION_ENC = iv(12) | tag(16) | ciphertext), opened in memory only, never logged.
# off (default) | fake (dev/test: fixtures, no Telegram) | live (production refuses fake).
# BANK_FEED_MODE=off
# BANK_FEED_API_ID=<my.telegram.org api id>
# BANK_FEED_API_HASH=<my.telegram.org api hash>
# BANK_FEED_SESSION_ENC=<base64 of the encrypted session from the bank-feed-login CLI>
# The session key (D-52 D3): 32 random bytes, base64. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Production: ONLY as a file (Docker secret), mode 0400 or 0600 (a wider file is refused); the
# worker and the login CLI read it once and drop both variables from their environment.
# BANK_FEED_ENC_KEY_FILE=/run/secrets/bank_feed_enc_key
# Dev/test only (refused in production; never both at once):
# BANK_FEED_ENC_KEY=<32 random bytes, base64>
# History poll interval in seconds, 5..60 (default 20).
# BANK_FEED_POLL_SEC=20
# bank-feed:inject (synthetic bank messages) is a dev tool: it refuses unless BANK_FEED_MODE=fake,
# no live setting (SESSION_ENC, API_HASH, ENC_KEY_FILE) is present and, checked after connecting,
# the database is the URL's own *_test one or carries the dev marker ggpin.env = dev (set by
# db:seed). It must not be shipped in the production image.
