# apps/admin — copy to apps/admin/.env.local. VITE_* values are shipped to the browser:
# never put a secret here.

VITE_API_URL=http://localhost:5000/api/v1
VITE_ENV_LABEL=DEV

# Development only: comma-separated endpoint groups answered by the in-browser mock
# (auth, confirmations). A production build with any value here fails.
VITE_API_MOCKS=
