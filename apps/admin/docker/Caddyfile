# Static file server of the admin SPA image (apps/admin/Dockerfile). Internal only: TLS, the
# public hostname, access logs and the VPN-only rule (D-73 (10)) belong to the reverse proxy.
# {$ADMIN_API_ORIGIN} (e.g. https://api.ggpin.uz) is checked by docker/entrypoint.sh before Caddy
# starts: the CSP must never be built with an empty connect-src origin.
{
	admin off
	persist_config off
	auto_https off
}

(security_headers) {
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' {$ADMIN_API_ORIGIN}; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'"
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		Permissions-Policy "accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
}

:8080 {
	root * /srv/admin
	encode zstd gzip
	import security_headers

	handle /healthz {
		header Cache-Control no-store
		respond "ok" 200
	}

	# Vite fingerprints everything under /assets: an asset that EXISTS is cached for a year. A
	# missing one is a 404 (handle_errors below, no-store), never index.html: the SPA fallback would
	# otherwise be cached under the asset's URL (e.g. an old hashed file asked for after a release).
	@assetFound {
		path /assets/*
		file
	}
	handle @assetFound {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle /assets/* {
		error 404
	}

	# Everything else is the SPA: index.html for every route, always revalidated.
	handle {
		header Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}

	handle_errors {
		import security_headers
		header Cache-Control no-store
		respond "{err.status_code} {err.status_text}"
	}
}
