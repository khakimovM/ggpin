# apps/web — copy to apps/web/.env.local. NEXT_PUBLIC_* values are shipped to the browser:
# never put a secret here. A production build requires the first three and fails if
# NEXT_PUBLIC_API_MOCKS is not empty.

NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_BOT_USERNAME=ggpin_bot
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Development only: comma-separated groups served by the mock API
# (recipients,quotes,orders,referrals: they follow phases 5 and 10). The wallet and payments
# endpoints are real since phase 4: naming `wallet` or `payments` here fails the config.
# Leave empty to use the real API.
NEXT_PUBLIC_API_MOCKS=

# Operator account link for the "write to support" entry, https://t.me/<handle> only (hidden when
# empty). Shown on the public contacts page too, so any other host, a port, credentials, a query or
# a hash fails the build.
NEXT_PUBLIC_SUPPORT_URL=

# Public Telegram channel of the brand, https://t.me/<channel> only (hidden when empty). Shown in
# the website footer and on the contacts page. Same rule as the support link.
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=

# SERVER-ONLY (not NEXT_PUBLIC, never sent to the browser): where the Next.js server reaches the
# API for the website's server-side rendering (the public catalog). Empty means
# NEXT_PUBLIC_API_URL. In Docker: http://api:5000/api/v1. Same shape rules as the public URLs.
API_INTERNAL_URL=

# E2E_PROBES — only for e2e builds (Playwright's web server sets it), never in production: it turns on
# test-only pages (token probe, pages that throw on purpose). Without it they answer 404.
# E2E_PROBES=
