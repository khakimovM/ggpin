# apps/web — copy to apps/web/.env.local. NEXT_PUBLIC_* values are shipped to the browser:
# never put a secret here. A production build requires the first three and fails if
# NEXT_PUBLIC_API_MOCKS is not empty.

NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_BOT_USERNAME=ggpin_bot
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Development only: comma-separated groups served by the mock API
# (recipients,quotes,wallet,orders,payments,referrals). Leave empty to use the real API.
NEXT_PUBLIC_API_MOCKS=

# Operator account link for the "write to support" entry (hidden when empty).
NEXT_PUBLIC_SUPPORT_URL=
