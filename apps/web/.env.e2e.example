# apps/web — settings for the Playwright journeys that talk to a real API (phase 7 S12).
# Not NEXT_PUBLIC: nothing here is shipped to the browser. Placeholders only; real values go in
# an untracked apps/web/.env.e2e. The smoke suite (e2e/*.spec.ts today) needs none of these.

# Token of a throw-away test bot (never the production bot): used to sign test initData.
E2E_TEST_BOT_TOKEN=<test-bot-token>

# API under test (a dev API started with FULFILLMENT_DRY_RUN=true).
E2E_API_URL=http://localhost:5000/api/v1

# Test database; the name must end with _test (guarded in the e2e setup).
E2E_DATABASE_URL=postgresql://ggpin:ggpin@localhost:5433/ggpin_web_e2e_test

# Test Redis, separate database index from dev.
E2E_REDIS_URL=redis://localhost:6379/3
