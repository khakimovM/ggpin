{
  "name": "ggpin",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --concurrency=1",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate --workspace=api --if-present",
    "db:deploy": "npm run db:deploy --workspace=api --if-present",
    "db:seed": "npm run db:seed --workspace=api --if-present",
    "db:studio": "npm run db:studio --workspace=api --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "secrets:scan": "gitleaks detect --no-banner",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^15.5.28",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "fastify": "5.12.7",
    "next": {
      "postcss": "8.5.29"
    }
  }
}
