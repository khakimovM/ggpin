# ============================================================
# ggpin — env templates live next to each app (placeholders only, NEVER commit real values):
#   apps/api/.env.example     -> apps/api/.env
#   apps/worker/.env.example  -> apps/worker/.env      (the only place for wallet/supplier secrets)
#   apps/web/.env.example     -> apps/web/.env.local
#   apps/admin/.env.example   -> apps/admin/.env.local
# Local Postgres/Redis credentials are fixed in docker-compose.yml.
# ============================================================
