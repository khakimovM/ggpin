# ============================================================
# ggpin — environment template. Copy per app: apps/api/.env, apps/worker/.env,
# apps/web/.env.local, apps/admin/.env.local. Placeholders only. NEVER commit real values.
# ============================================================

# ---------- shared ----------
NODE_ENV=development
BRAND_NAME=ggpin
DATABASE_URL=postgresql://ggpin:ggpin@localhost:5432/ggpin
REDIS_URL=redis://localhost:6379

# ---------- apps/api ----------
API_PORT=5000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173
# prod: https://ggpin.uz/tg — dev: an HTTPS tunnel to the local web app
MINI_APP_URL=https://<tunnel-or-domain>/tg
JWT_ACCESS_SECRET=change-me-min-32-chars
JWT_REFRESH_SECRET=change-me-min-32-chars
TG_SESSION_SECRET=change-me-min-32-chars
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=ggpin_bot
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TG_INITDATA_MAX_AGE_SEC=86400
ADMIN_TELEGRAM_IDS=
ADMIN_CONFIRM_THRESHOLD_TIYIN=100000000
ADMIN_OPERATOR_REFUND_MAX_TIYIN=50000000
OWNER_ALERT_CHAT_ID=
TOPUP_MIN_TIYIN=500000
TOPUP_MAX_TIYIN=1000000000
# payments (sandbox in dev)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_MODE=true
UZUM_MERCHANT_ID=
UZUM_SECRET=
RAHMAT_MERCHANT_ID=
RAHMAT_SECRET=

# ---------- apps/worker (ONLY here — the API refuses to boot if these are set) ----------
FULFILLMENT_DRY_RUN=true
TON_NETWORK=testnet
TON_API_ENDPOINT=
TON_API_KEY=
TON_MNEMONIC_ENC=
WALLET_ENC_KEY=
TON_MAX_PER_ORDER_NANO=50000000000
TON_MAX_DAILY_NANO=500000000000
TON_MIN_BALANCE_ALERT_NANO=100000000000
FRAGMENT_SESSION_ENC_KEY=
PRICE_TOLERANCE_BPS=300
RESELLER_STARS_API_URL=
RESELLER_STARS_API_KEY=
SUPPLIER_MAX_PER_ORDER_MICRO_USDT=200000000

# ---------- apps/web ----------
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_BOT_USERNAME=ggpin_bot
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- apps/admin ----------
VITE_API_URL=http://localhost:5000/api/v1
VITE_ENV_LABEL=DEV
