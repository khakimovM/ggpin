# /etc/ggpin/worker.env (0600 root) — env_file of the `worker` service in deploy/compose.prod.yml.
# PLACEHOLDERS ONLY. The worker refuses to boot with any API-only secret (JWT_*, OTP_PEPPER,
# PAY_TOKEN_PEPPER, TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET, provider keys) and, in production,
# with placeholder values. NODE_ENV, BANK_FEED_MODE=off and the *_FILE paths are set by compose.
# Key files (WALLET_ENC_KEY, FRAGMENT_SESSION_ENC_KEY) are Docker secrets, NOT lines here
# (deploy/COMPOSE.md "Secrets": install -m 0400 -o 10003, and only once the worker image runs as 10003).
# No bank-feed session values here: they belong to bankfeed.env only (D-73 (6)).

BRAND_NAME=ggpin
LOG_LEVEL=info
TELEGRAM_BOT_USERNAME=ggpin_bot

# Runtime DB role (P11-S6) and the Redis `worker` ACL user.
DATABASE_URL=postgresql://<runtime-role>:<password>@postgres:5432/ggpin
REDIS_URL=redis://worker:<redis-worker-password>@redis:6379

# Real money moves only with false; set it explicitly (no default in production).
FULFILLMENT_DRY_RUN=true

# TON / Fragment (phase 5; D-56, D-71). Limits are hard stops; a breach holds the order.
TON_NETWORK=mainnet
TON_API_ENDPOINT=https://<ton-api-endpoint>
TON_API_KEY=<issued-by-the-ton-api-provider>
TON_MNEMONIC_ENC=<sealed-blob-from-the-wallet-cli>
TON_MAX_PER_ORDER_NANO=50000000000
TON_MAX_DAILY_NANO=500000000000
TON_MIN_BALANCE_ALERT_NANO=100000000000
PRICE_TOLERANCE_BPS=300
RESELLER_STARS_API_URL=
RESELLER_STARS_API_KEY=
SUPPLIER_MAX_PER_ORDER_MICRO_USDT=200000000

# P2P top-up matcher: the time knobs and daily caps MUST equal api.env.
TOPUP_INTENT_TTL_SEC=1800
TOPUP_LATE_GRACE_SEC=86400
TOPUP_CAPACITY_HOLD_SEC=3600
TOPUP_NEW_ACCOUNT_AGE_SEC=604800
TOPUP_DAILY_MAX_TIYIN=500000000
TOPUP_NEW_ACCOUNT_DAILY_MAX_TIYIN=50000000
BANK_TIME_SKEW_SEC=600

# The pinned bank-bot ids are required in production even with the listener off (matcher re-check).
BANK_FEED_HUMO_BOT_ID=<numeric-id-of-HUMOcardbot>
BANK_FEED_UZCARD_BOT_ID=<numeric-id-of-CardXabarBot>
BANK_FEED_LOCK_TIMEOUT_MS=3000
