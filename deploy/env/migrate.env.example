# /etc/ggpin/migrate.env (0600 root) — env_file of the one-shot `migrate` service
# (`docker compose run --rm migrate` = prisma migrate deploy). PLACEHOLDERS ONLY.
# The migration role owns the tables (DDL); the api/worker runtime role is a different one (P11-S6).
# Never `migrate reset` against this database.

DATABASE_URL=postgresql://<migration-role>:<password>@postgres:5432/ggpin
