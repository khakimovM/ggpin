# Interpolation values for deploy/compose.prod.yml (`docker compose --env-file /etc/ggpin/compose.env`).
# Copy to /etc/ggpin/compose.env (0600 root). NOTHING SECRET goes here: these values are visible in
# `docker compose config` and in the container metadata. Secrets: deploy/env/*.env.example + secrets dir.

# Images from the private registry, pinned by digest (D-73 (5)). The same digests run on staging first.
API_IMAGE=<registry>/ggpin-api@sha256:<digest>
WEB_IMAGE=<registry>/ggpin-web@sha256:<digest>
ADMIN_IMAGE=<registry>/ggpin-admin@sha256:<digest>
WORKER_IMAGE=<registry>/ggpin-worker@sha256:<digest>
MIGRATE_IMAGE=<registry>/ggpin-migrate@sha256:<digest>
# deploy/proxy/Dockerfile (pinned Caddy, file capability removed, uid 65532).
PROXY_IMAGE=<registry>/ggpin-proxy@sha256:<digest>
# Optional overrides; compose.prod.yml pins upstream digests by default.
#POSTGRES_IMAGE=postgres:16.15-alpine@sha256:<digest>
#REDIS_IMAGE=redis:7.4.9-alpine@sha256:<digest>

# Admin CSP connect-src (an https origin, no path). The admin name itself: the SPA calls the admin API
# on its own origin (https://admin.ggpin.uz/api/v1, behind WireGuard; deploy/proxy/README.md §6), and
# the admin image is built with the matching VITE_API_URL (apps/admin/Dockerfile).
ADMIN_API_ORIGIN=https://admin.ggpin.uz

# Where the env files and the secret files live on the host (root-owned; deploy/COMPOSE.md "Secrets").
GGPIN_ENV_DIR=/etc/ggpin
GGPIN_SECRETS_DIR=/etc/ggpin/secrets

# Proxy: published on 80/443 of every IPv4 address (0.0.0.0 = IPv4 only; no AAAA record, see
# deploy/proxy/README.md). Staging on the same VPS uses other ports/addresses.
PROXY_BIND_ADDR=0.0.0.0
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
# deploy/proxy/Caddyfile (relative to deploy/).
PROXY_CADDYFILE=./proxy/Caddyfile
# Public names (D-13). The admin name only answers WireGuard peers (D-73 (10)).
SITE_DOMAIN=ggpin.uz
API_DOMAIN=api.ggpin.uz
ADMIN_DOMAIN=admin.ggpin.uz
# ACME account e-mail (certificate expiry notices). The first start uses the Let's Encrypt STAGING
# directory (deploy/proxy/README.md §5), then this line is commented out again. preflight.sh FAILs on a
# staging CA (unless --allow-staging) and on a PROXY_TLS that is not an e-mail ("internal" = local test only).
PROXY_TLS=<owner e-mail>
#PROXY_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# The edge network and the proxy's fixed address on it (= the API's TRUST_PROXY). Each compose project
# on the host needs its own subnet (staging: e.g. 172.30.20.0/24 and 172.30.20.2).
EDGE_SUBNET=172.30.10.0/24
EDGE_IP_RANGE=172.30.10.128/25
PROXY_EDGE_IP=172.30.10.2

# false in production (worker/api/bankfeed need the internet); true only for the local prod-like test.
EGRESS_INTERNAL=false
