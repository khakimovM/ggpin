# /etc/ggpin/api.env (0600 root) — env_file of the `api` service in deploy/compose.prod.yml.
# PLACEHOLDERS ONLY. The API refuses to boot in production with a "change-me..." or "<...>" value, a
# generated secret shorter than 32 characters, or ANY worker-only variable (TON_*, WALLET_*,
# FRAGMENT_*, BANK_FEED_*_KEY/_HASH/_SESSION*, supplier keys) — never copy worker.env lines here.
# NODE_ENV, API_PORT and TRUST_PROXY are set by compose.prod.yml itself.
# Generate a secret: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

BRAND_NAME=ggpin
LOG_LEVEL=info
SWAGGER_ENABLED=false

# Runtime DB role (not the migration/DDL owner, P11-S6) and the Redis `api` ACL user.
DATABASE_URL=postgresql://<runtime-role>:<password>@postgres:5432/ggpin
REDIS_URL=redis://api:<redis-api-password>@redis:6379

WEB_URL=https://ggpin.uz
ADMIN_URL=https://admin.ggpin.uz
MINI_APP_URL=https://ggpin.uz/tg

# Session / OTP / pay-link secrets: each one different (the API checks), 32+ random characters.
JWT_ACCESS_SECRET=change-me-access-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars
TG_SESSION_SECRET=change-me-tg-session-min-32-chars
OTP_PEPPER=change-me-otp-pepper-min-32-chars
PAY_TOKEN_PEPPER=change-me-pay-token-pepper-min-32-chars

# Telegram bot (API only, docs/10). Production requires webhook mode.
TELEGRAM_BOT_TOKEN=<bot-id>:<token-from-botfather>
TELEGRAM_BOT_USERNAME=ggpin_bot
TELEGRAM_BOT_MODE=webhook
TELEGRAM_WEBHOOK_URL=https://api.ggpin.uz/api/v1/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=change-me-webhook-secret-32-to-256-chars-A-Za-z0-9_-
TELEGRAM_NEWS_CHANNEL_URL=
TG_INITDATA_MAX_AGE_SEC=86400

# Admin (D-53, D-71): numeric Telegram ids; the first alert chat is the primary owner.
ADMIN_TELEGRAM_IDS=<owner-id>,<partner-id>
OWNER_ALERT_CHAT_ID=<owner-id>,<partner-id>
ADMIN_CONFIRM_THRESHOLD_TIYIN=100000000
ADMIN_OPERATOR_REFUND_MAX_TIYIN=50000000

# P2P top-ups (docs/05 §6). The time knobs and daily caps MUST equal worker.env.
TOPUP_MIN_TIYIN=500000
TOPUP_MAX_TIYIN=200000000
TOPUP_STEP_TIYIN=100000
TOPUP_DAILY_MAX_TIYIN=500000000
TOPUP_NEW_ACCOUNT_DAILY_MAX_TIYIN=50000000
TOPUP_SUFFIX_MAX_SOM=999
TOPUP_INTENT_TTL_SEC=1800
TOPUP_LATE_GRACE_SEC=86400
TOPUP_CAPACITY_HOLD_SEC=3600
TOPUP_NEW_ACCOUNT_AGE_SEC=604800
BANK_FEED_HEARTBEAT_MAX_AGE_SEC=120

PRICE_TOLERANCE_BPS=300
PRICING_ALLOW_SIMULATED=false

# Payment providers: later (D-04). Leave empty until then.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_MODE=false
UZUM_MERCHANT_ID=
UZUM_SECRET=
RAHMAT_MERCHANT_ID=
RAHMAT_SECRET=
