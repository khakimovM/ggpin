# /etc/ggpin/bankfeed.env (0600 root) — env_file of the `bankfeed` service (profile `bankfeed`,
# enabled only after the WORKER_ROLE split, D-73 (6); until then compose hard-stops the service and
# this file is not read). PLACEHOLDERS ONLY.
# Only the bank-feed listener's own values: no wallet, Fragment or supplier secret here.
# BANK_FEED_ENC_KEY is NEVER a line here: it is the Docker secret bank_feed_enc_key
# (BANK_FEED_ENC_KEY_FILE is set by compose; an inline key is refused in production, D-52 D3).
# BANK_FEED_SESSION_ENC comes from the login CLI (docs/05 runbook 1) straight into this file,
# never through the screen.

BRAND_NAME=ggpin
LOG_LEVEL=info
TELEGRAM_BOT_USERNAME=ggpin_bot
# Required by the worker env schema in production (no default: apps/worker/src/config/env.ts), and the
# bankfeed role runs the worker image. It does NOT make this container safe to run as a full worker:
# with dry-run on, price sync would still write simulated FX/price snapshots to the production DB
# (review N1). The bankfeed role never fulfils; the WORKER_ROLE change decides whether the line stays.
FULFILLMENT_DRY_RUN=true

DATABASE_URL=postgresql://<runtime-role>:<password>@postgres:5432/ggpin
REDIS_URL=redis://bankfeed:<redis-bankfeed-password>@redis:6379

# off until the session exists and runbook 1a is done; then live.
BANK_FEED_MODE=off
BANK_FEED_API_ID=<api_id-from-my.telegram.org>
BANK_FEED_API_HASH=<api_hash-from-my.telegram.org>
BANK_FEED_SESSION_ENC=<sealed-blob-from-bank-feed-login>
BANK_FEED_HUMO_BOT_ID=<numeric-id-of-HUMOcardbot>
BANK_FEED_UZCARD_BOT_ID=<numeric-id-of-CardXabarBot>
BANK_FEED_LOCK_TIMEOUT_MS=3000
BANK_FEED_POLL_SEC=20

# Same values as worker.env / api.env (the matcher shares them).
TOPUP_INTENT_TTL_SEC=1800
TOPUP_LATE_GRACE_SEC=86400
TOPUP_CAPACITY_HOLD_SEC=3600
TOPUP_NEW_ACCOUNT_AGE_SEC=604800
TOPUP_DAILY_MAX_TIYIN=500000000
TOPUP_NEW_ACCOUNT_DAILY_MAX_TIYIN=50000000
BANK_TIME_SKEW_SEC=600
